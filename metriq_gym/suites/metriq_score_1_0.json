{
  "name": "metriq_score_1_0",
  "version": "1.0",
  "description": "Canonical benchmark configurations for Metriq Score 1.0 as reported in the Metriq paper.",
  "source": "https://arxiv.org/abs/2603.08680v1",
  "full_suite_warning": "The complete Metriq Score 1.0 suite dispatches 22 hardware benchmark jobs. It can consume substantial device quota, runtime, and money, and some components require provider-specific capabilities.",
  "benchmarks": [
    {
      "name": "bseq",
      "component": "bseq",
      "config": {
        "benchmark_name": "BSEQ",
        "shots": 1000
      }
    },
    {
      "name": "eplg_100q_chain",
      "component": "eplg",
      "config": {
        "benchmark_name": "EPLG",
        "num_qubits_in_chain": 100,
        "lengths": [
          2,
          4,
          8,
          16,
          30,
          50,
          70,
          100,
          150,
          200,
          300,
          500
        ],
        "num_samples": 10,
        "shots": 1000,
        "seed": 12345,
        "two_qubit_gate": "cz",
        "one_qubit_basis_gates": [
          "rz",
          "rx",
          "x"
        ],
        "decompose_clifford_ops": false,
        "constrain_rb_offset_b": false
      }
    },
    {
      "name": "mirror_circuits_8q_64l",
      "component": "mirror-circuits",
